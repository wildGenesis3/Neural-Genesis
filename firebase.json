{
  "hosting": {
    "public": "dist",
    "trailingSlash": true,
    "predeploy": ["npm run build"],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.log",
      "server.js",
      "package.json",
      "package-lock.json",
      "DESIGN.md",
      "README.md",
      "partials/**",
      "layout.cjs"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
