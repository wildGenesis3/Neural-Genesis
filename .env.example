# Gmail SMTP Configuration Example
# To use Gmail SMTP:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password under Security -> App Passwords: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character App Password into SMTP_PASS below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM="Neural Genesis <your-email@gmail.com>"

# Recipient Email (where you want to receive the contact form submissions)
RECEIVE_EMAIL=your-recipient@company.com

# Server Port
PORT=3000
